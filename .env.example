# Copier ce fichier en .env puis remplir les valeurs réelles.
# Ne jamais committer le fichier .env (il est ignoré par git).

# Base de données — MySQL 8.3 (port hôte 3306 en dev, 3307 via Docker)
DATABASE_URL=mysql://sap_user:MOT_DE_PASSE@localhost:3306/sap_academy

# Variables Docker Compose (obligatoires pour `docker compose`)
MYSQL_PASSWORD=MOT_DE_PASSE_FORT
MYSQL_ROOT_PASSWORD=MOT_DE_PASSE_ROOT_FORT
APP_PORT=3000
SESSION_SECRET=CHANGER_PAR_UNE_VALEUR_ALEATOIRE_DE_32_CARACTERES_MINIMUM
APP_ORIGIN=http://localhost:3000

# Sécurité API (optionnel) : si renseigné, les écritures exigent
# Authorization: Bearer <valeur> sur POST/PATCH
API_WRITE_TOKEN=

# Gmail — OAuth 2.0 (Google Cloud Console → Identifiants OAuth)
# Redirection à enregistrer : http://localhost:3000/api/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/callback
GMAIL_SYNC_LABEL=SAP
GMAIL_SENDER_DOMAINS=
GMAIL_SUBJECT_KEYWORDS=