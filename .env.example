# Base de données — PostgreSQL (Neon, Vercel Postgres, Supabase, etc.)
# Format: postgresql://user:password@host:port/database?sslmode=require
DATABASE_URL=

# Authentification
SESSION_SECRET=ChangeMeWithARandom32CharsMinimum!
APP_ORIGIN=https://your-domain.vercel.app

# Sécurité API (optionnel)
API_WRITE_TOKEN=

# Gmail — OAuth 2.0 (optionnel)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=https://your-domain.vercel.app/api/gmail/callback
GMAIL_SYNC_LABEL=SAP
GMAIL_SENDER_DOMAINS=
GMAIL_SUBJECT_KEYWORDS=